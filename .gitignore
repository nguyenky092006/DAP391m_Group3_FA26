# Recoverable local quarantine created by the 2026-09-14 protocol reset.
protocol_reset_quarantine/

# Versioned local B6 archive: keep the manifest trackable, not multi-GB payloads.
archive/b6_superseded/*/*
!archive/b6_superseded/*/ARCHIVE_MANIFEST.csv

# Superseded plan/spec snapshots: keep payload local and manifest trackable.
archive/spec_superseded/*/snapshots/
!archive/spec_superseded/*/ARCHIVE_MANIFEST.csv


{
  "schema_version": "b4.accent_probe.v1",
  "seed": 391,
  "split_version": "emotion_stratified_v1",
  "split_manifest": "data/manifests/emotion_stratified_v1.csv",
  "feature_table": "data/interim/features/b4_features_v1/b4_full_feature_table.parquet",
  "fit_split": "train",
  "evaluation_split": "validation",
  "forbidden_split": "test",
  "accent_order": ["central", "north", "south"],
  "representations": [
    {
      "name": "handcrafted_174",
      "column_prefixes": ["mfcc_mean_", "mfcc_std_", "egemaps_", "pitch_voiced_", "pitch_f0_"]
    },
    {
      "name": "wav2vec2_768",
      "column_prefixes": ["wav2vec2_"]
    }
  ],
  "probe": {
    "estimator": "sklearn.linear_model.LogisticRegression",
    "solver": "lbfgs",
    "C": 1.0,
    "class_weight": "balanced",
    "max_iter": 2000,
    "tolerance": 0.001,
    "scaler_fit_scope": "train_only"
  },
  "permutation_baseline": {
    "permutations": 50,
    "shuffle_scope": "training_accent_labels_only"
  },
  "sample_bootstrap": {
    "resamples": 2000,
    "unit": "validation_sample_emotion_stratified",
    "confidence_level": 0.95
  },
  "interpretation": "Development diagnostic under the sample-level emotion-stratified protocol. Speaker overlap is allowed, so results may partially reflect speaker-associated information and are not evidence of speaker-independent accent information."
}
